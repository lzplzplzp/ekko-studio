{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekkostudio.xyz/schemas/butler-projects-index-v1.json",
  "title": "Butler projects index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "displayName", "businessLine", "workdir"],
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
          "description": "Stable key such as value-added/xmglpt. procurement/ is rejected by the butler."
        },
        "displayName": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "businessLine": { "type": "string", "minLength": 1 },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace passed to the Studio session. Use a configured path, not a password-bearing URL."
        },
        "archived": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "agentProfile": { "type": "string" },
        "groupRoomId": {
          "type": "string",
          "description": "Optional ops room id. Online ops tasks suggest this room; the MVP still opens a single chat."
        },
        "databases": {
          "type": "array",
          "items": { "$ref": "#/$defs/database" }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "env"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "env": { "enum": ["test", "staging", "prod-ro"] },
        "readOnly": { "type": "boolean" },
        "credentialVersion": {
          "type": "string",
          "description": "Version label only. Do not put a password, token, or connection string here."
        },
        "credentialValidToday": { "type": "boolean" }
      }
    }
  }
}
